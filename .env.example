# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real secrets.

# --- Required: Google Gemini (the chat assistant) ---------------------------
# Create/rotate a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model id. Defaults to the value in
# `lib/model-config.ts` when unset.
GEMINI_MODEL=gemini-2.0-flash

# --- Optional: lead/notification email delivery (Resend) --------------------
# Without RESEND_API_KEY the lead pipeline stores leads locally but cannot send
# email, so `/api/lead` responds with 503 and the UI shows the fallback contact.
RESEND_API_KEY=your_resend_api_key_here

# Inbox that receives recruiter lead notifications.
NOTIFICATION_EMAIL=rajatsharma221098@gmail.com
